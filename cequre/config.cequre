config {
	output: "_generated";
	core {
		api {
			prefix: "/api";
		}
		graphql {
			enabled: true;
			playground: true;
			introspection: true;
		}
	}
	security {
		cors {
			origin: ["*"];
			credentials: true;
		}
		auth {
			strategies: ["jwt"];
			jwt {
				accessTokenExpiry: "15m";
				refreshTokenExpiry: "7d";
			}
		}
	}
	monitoring {
		enabled: true;
		apiKey: env("MONITORING_API_KEY");
		healthCheck {
			path: "/health";
		}
	}
	// exporters: {
	//   otel: { endpoint: env("OTEL_ENDPOINT"); serviceName: "my-app" };
	//   webhook: [
	//     { url: env("MONITORING_WEBHOOK_URL"); filter: ["error", "fatal"] };
	//     { url: env("MONITORING_WEBHOOK_URL_2"); filter: ["fatal"] };
	//   ];
	// }
	adminUi {
		collection: "admins";
	}
}
